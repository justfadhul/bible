# Copy to .env and fill in from Supabase → Project Settings → API.
# Only ever the anon (publishable) key here — it is protected by RLS and is
# meant to ship in the client. The service-role key bypasses RLS entirely and
# must never appear in this file or in the bundle.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
