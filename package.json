{
  "name": "spin-catalog",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A two-person daily Bible reading wheel. Spin, read the passage, discuss.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "validate": "node scripts/validate-catalog.mjs",
    "simulate": "node scripts/simulate-spins.mjs",
    "no-dupes": "node scripts/check-no-duplication.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run validate && npm run no-dupes && npm run test && npm run simulate && npm run build",
    "build:single": "vite build && node scripts/build-single-file.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.0.5",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
